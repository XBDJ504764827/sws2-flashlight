{
  "sws2-flashlight": {
    "Debug": false,
    "Behavior": {
      "UpdateIntervalTicks": 1,
      "NotifyOnToggle": true,
      "TurnOffOnDeath": true,
      "TurnOffOnTeamSwitch": true,
      "DisableInSpectator": true
    },
    "Light": {
      "Color": "#FFFFFF",
